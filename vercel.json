{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/buzzin",
      "destination": "https://buzzin-nine.vercel.app/"
    },
    {
      "source": "/buzzin/",
      "destination": "https://buzzin-nine.vercel.app/"
    },
    {
      "source": "/buzzin/:path*",
      "destination": "https://buzzin-nine.vercel.app/:path*"
    }
  ]
}
