{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix web/landing",
  "buildCommand": "npm run build --prefix web/landing && node scripts/build-static.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/buzzin",
      "destination": "https://buzzin-nine.vercel.app/"
    },
    {
      "source": "/buzzin/",
      "destination": "https://buzzin-nine.vercel.app/"
    },
    {
      "source": "/buzzin/:path*",
      "destination": "https://buzzin-nine.vercel.app/:path*"
    }
  ]
}
