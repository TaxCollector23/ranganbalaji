{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'Static site: no dependencies required'",
  "buildCommand": "node scripts/build-static.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/buzzin",
      "destination": "https://buzzin-nine.vercel.app/"
    },
    {
      "source": "/buzzin/",
      "destination": "https://buzzin-nine.vercel.app/"
    },
    {
      "source": "/buzzin/:path*",
      "destination": "https://buzzin-nine.vercel.app/:path*"
    }
  ]
}
